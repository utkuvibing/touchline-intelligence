{
  "schema_version": "1.0",
  "missing_play_pattern": "__MISSING_PLAY_PATTERN__",
  "numeric_tolerance_multiplier": 64,
  "v1_form": {
    "categorical_fields": [
      "body_part_name",
      "technique_name",
      "play_pattern_name"
    ],
    "reference_levels": {
      "body_part_name": "Right Foot",
      "technique_name": "Normal",
      "play_pattern_name": "Regular Play"
    },
    "rare_min_rows": 25,
    "presence_fields": [
      "first_time",
      "under_pressure"
    ]
  },
  "bundles": {
    "F0": {
      "scaling": "population_ddof_0"
    },
    "F1": {
      "quantiles": [
        0.0,
        0.25,
        0.5,
        0.75,
        1.0
      ],
      "degree": 3,
      "extrapolation": "linear",
      "include_bias": false,
      "order": "C",
      "handle_missing": "error",
      "sparse_output": false,
      "basis_columns_per_feature": 6,
      "interaction": "standardized_raw_distance_times_standardized_raw_angle"
    }
  }
}
