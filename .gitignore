# Planning scratch — durable decisions are promoted to the local docs/ tree, which is not published
.scratch/

# Local knowledge-graph output from the graphify tool. Regenerated on demand, never authoritative.
graphify-out/

# Internal working material. Kept locally, never published: agent instructions, the execution plan,
# the job search behind the project, and the CV's personal contact details describe how the work is
# organised rather than what was built. The public repository carries the product and its evidence.
AGENTS.md
CLAUDE.md
CONTEXT.md
docs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Local data and generated artifacts.
# `data/*` rather than `data/` so the negation below works — git does not descend into an
# excluded directory, so `data/` + `!data/fixtures/` would silently ignore the fixtures too.
data/*
!data/fixtures/
# Provenance records are committed: they pin which StatsBomb bytes produced the measured counts
# in ADR 0004, so another machine can verify it read the same source.
!data/provenance/
artifacts/*
!artifacts/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
