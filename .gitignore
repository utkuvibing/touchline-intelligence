# Planning scratch — durable decisions are promoted to docs/adr/ and docs/research/
.scratch/

# Local knowledge-graph output from the graphify tool. Regenerated on demand, never authoritative.
graphify-out/

# Author-private material. Kept locally, never published: it documents the job search behind the
# project rather than the project itself, and the CV carries personal contact details.
docs/TARGETING.md
docs/research/job-market-methodology.md
docs/*.pdf

# Superseded planning material. PLAN.md v2 replaced all of it; it is kept on disk so the earlier
# reasoning stays recoverable, but publishing it only gives a reader two plans to reconcile.
docs/phases/
docs/PLAN-v1-superseded.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Local data and generated artifacts.
# `data/*` rather than `data/` so the negation below works — git does not descend into an
# excluded directory, so `data/` + `!data/fixtures/` would silently ignore the fixtures too.
data/*
!data/fixtures/
# Provenance records are committed: they pin which StatsBomb bytes produced the measured counts
# in ADR 0004, so another machine can verify it read the same source.
!data/provenance/
artifacts/*
!artifacts/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
