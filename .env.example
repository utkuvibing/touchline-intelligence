# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored. Never put a real credential in this example file, and never commit .env.
# Every variable is read by backend/src/touchline/config.py and validated at startup — an unknown
# variable is a startup error, not a silently ignored line.

# Environment label. Surfaced by /health to make it obvious which instance is being inspected.
# This is a label only. It is NOT a safety control: `poe ingest` decides whether a database is
# local by inspecting TOUCHLINE_DB_URL, never by reading this value. Setting it to `local` in front
# of a deployment DSN protects nothing.
TOUCHLINE_ENVIRONMENT=local

# PostgreSQL connection string. Required — there is no default.
# Port 5433 matches infra/docker-compose.yml, which avoids colliding with a locally installed
# PostgreSQL on 5432.
#
# Pointing this at a deployed database is the one change most likely to cause damage: `poe ingest`
# writes application data. It refuses any non-local target unless that exact database is named for
# the run via TOUCHLINE_ALLOW_REMOTE_WRITES. That variable is deliberately absent from this file —
# it authorises a single command, not a standing configuration, so it belongs inline on the command
# line and never in .env. See README.md.
TOUCHLINE_DB_URL=postgresql://touchline:localdev@localhost:5433/touchline

# Comma-separated browser origins allowed to call this API. No wildcard is supported: `*` on a
# public API lets any page on the internet read it from a visitor's browser.
# Deployments set their real frontend origin, e.g. https://touchline-intelligence.vercel.app
TOUCHLINE_CORS_ORIGINS=http://localhost:3000
