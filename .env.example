# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored. Never put a real credential in this example file, and never commit .env.
# Every variable is read by backend/src/touchline/config.py and validated at startup — an unknown
# variable is a startup error, not a silently ignored line.

# Environment label. Surfaced by /health to make it obvious which instance is being inspected.
TOUCHLINE_ENVIRONMENT=local

# PostgreSQL connection string. Required — there is no default.
# Port 5433 matches infra/docker-compose.yml, which avoids colliding with a locally installed
# PostgreSQL on 5432.
TOUCHLINE_DB_URL=postgresql://touchline:localdev@localhost:5433/touchline
